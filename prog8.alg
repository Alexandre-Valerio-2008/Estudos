algoritmo "Positivo ou negativo"
var
n1: inteiro         
inicio 
    escreval("Digite um numero: ")
    leia(n1)              
    se  n1 > 0 entao
    escreval("Positivo")
    senao se n1 < 0 entao
    escreval ("Nao positivo")
    senao 
    escreval ("É zero")
    fimse
    fimse
    fimalgoritmo