algoritmo "Media"
var
n1, n2, n3, resultado: inteiro
inicio
    escreval("Digite sua priemira nota: ")
    leia(n1)
    escreval("Digite sua priemira nota: ")
    leia(n2)
    escreval("Digite sua priemira nota: ")
    leia(n3)
    resultado <- (n1 + n2 + n3)/3
    escreval("A sua média é: ", resultado)
    fimalgoritmo