algoritmo "Vetores e Matrizes"
var nomes: vetor[0..4] de caractere
inicio
nomes[0] <- "Ana"
nomes[1] <- "Carlos"
nomes[2] <- "Beatriz"
nomes[3] <- "Diego"
nomes[4] <- "Elisa"

escreval (nomes[0])
escreval (nomes[1])
escreval (nomes[2])
escreval (nomes[3])
escreval (nomes[4])
fimalgoritmo